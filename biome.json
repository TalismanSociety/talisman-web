{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!.claude", "!apps/portal/src/generated", "!**/routeTree.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAmbiguousAnchorText": "off",
        "noLabelWithoutControl": "off",
        "noNoninteractiveElementToInteractiveRole": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAltText": "off",
        "useButtonType": "off",
        "useFocusableInteractive": "off",
        "useIframeTitle": "off",
        "useKeyWithClickEvents": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        "noUselessFragments": "off",
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUnknownProperty": "off",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off",
        "useJsxKeyInIterable": "off",
        "useParseIntRadix": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@talismn/react-polkadot-api": "Chain access goes through polkadot-api (domains/chains/papi-client.ts); polkadot.js is gone.",
              "avail-js-sdk": "Chain access goes through polkadot-api (domains/chains/papi-client.ts); polkadot.js is gone.",
              "recoil": "State lives in rxjs observables bound with @react-rxjs/core (util/loadable.ts, util/persistedState.ts); recoil is gone.",
              "jotai": "State lives in rxjs observables bound with @react-rxjs/core (util/loadable.ts, util/persistedState.ts); jotai is gone."
            },
            "patterns": [
              {
                "group": ["@polkadot/**"],
                "message": "Chain access goes through polkadot-api (domains/chains/papi-client.ts); polkadot.js is gone."
              },
              {
                "group": ["jotai/**", "@recoiljs/**"],
                "message": "State lives in rxjs observables bound with @react-rxjs/core (util/loadable.ts, util/persistedState.ts); recoil and jotai are gone."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noConfusingVoidType": "off",
        "noExplicitAny": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noShadowRestrictedNames": "off",
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": ["tailwind"]
          }
        }
      }
    }
  }
}
