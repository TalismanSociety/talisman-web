{
  "private": true,
  "name": "talisman-web",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "prepare": "test ! -d .git || { git config --local --unset core.hooksPath '^\\.husky'; simple-git-hooks; }",
    "dev": "pnpm --filter @talismn/portal dev",
    "build": "pnpm -r build",
    "build:portal": "VITE_APP_COMMIT=${WORKERS_CI_COMMIT_SHA:-} NODE_OPTIONS=--max_old_space_size=6144 pnpm --filter @talismn/portal build:worker && pnpm run wrangler:redirect",
    "wrangler:redirect": "mkdir -p .wrangler/deploy && printf '{\"configPath\":\"../../apps/portal/dist/server/wrangler.json\"}' > .wrangler/deploy/config.json",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write --error-on-warnings",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm typecheck && pnpm knip && pnpm test && pnpm build:portal",
    "e2e": "pnpm --filter @talismn/portal e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "knip": "^6.45.1",
    "simple-git-hooks": "^2.14.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --error-on-warnings --no-errors-on-unmatched --staged"
  }
}
