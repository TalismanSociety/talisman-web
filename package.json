{
  "private": true,
  "name": "talisman-web",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "prepare": "test ! -d .git || simple-git-hooks",
    "dev": "pnpm --filter @talismn/portal dev",
    "build": "pnpm -r build",
    "build:portal": "VITE_SENTRY_RELEASE=${WORKERS_CI_COMMIT_SHA:-} NODE_OPTIONS=--max_old_space_size=4096 pnpm --filter @talismn/portal build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check-types": "pnpm -r check-types",
    "e2e": "pnpm --filter @talismn/portal e2e",
    "storybook": "pnpm -r --parallel storybook",
    "build-storybook": "pnpm -r build-storybook"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@talismn/eslint-config": "workspace:^",
    "eslint": "^9.2.0",
    "lint-staged": "^12.5.0",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.4.1",
    "simple-git-hooks": "^2.14.0",
    "typescript-eslint": "^7.15.0",
    "wrangler": "^4.147.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,scss,html,md,json}": "prettier --write"
  },
  "dependencies": {
    "@polkadot/api": "^16.4.1"
  }
}
