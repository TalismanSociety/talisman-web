{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/skills/*/bin/*.{js,mjs}", ".claude/skills/*/docker/*.mjs"],
      "ignoreDependencies": ["wrangler", "@polkadot/api", "@polkadot/util-crypto"]
    },
    "apps/portal": {
      "entry": ["scripts/*.ts", "scripts/posthog/provision.ts", "scripts/**/*.test.ts"],
      "ignore": ["src/test/cloudflare-workers.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "scripts/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  "includeEntryExports": true
}
